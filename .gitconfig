[user]
	name = Bart van Raaij
	email = info@bartvanraaij.nl
[init]
	defaultBranch = main
[core]
	autocrlf = input
	pager = delta
	excludesfile = /Users/bartvanraaij/.gitignore_global
[interactive]
	diffFilter = delta --color-only
[delta]
	features = decorations
	navigate = true    # use n and N to move between diff sections
	line-numbers = true
	#side-by-side = true
[merge]
	conflictstyle = diff3
	autoStash = true
[diff]
	colorMoved = default
[delta "decorations"]
	#file-style = omit
	hunk-header-style = omit
[push]
	autoSetupRemote = true
[alias]
	s = status
	d = diff
	dc = diff --cached
	l = log --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)%an <%ae>%Creset' --abbrev-commit -20
	unstage = restore --staged
	amend = commit --amend --no-edit
	recommit = commit --reuse-message=HEAD
	num-staged = diff --cached --num
	history = log -p --
[credential]
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager
#	helper = osxkeychain
#	helper = /usr/local/share/gcim-core/git-credential-manager
[credential "https://dev.azure.com"]
	useHttpPath = true
[credential "https://github.com"]
	username = bartvanraaij
