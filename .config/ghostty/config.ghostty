# Font
font-family = "BlexMono Nerd Font"
font-style = Light
font-thicken = true
font-style-bold = Light
font-style-italic = "Light Italic"
font-size = 13.5
adjust-cell-height = 4

# Shell
# First window creates session "main"; each further window gets its own session grouped
# with it (same windows, independent navigation), cleaned up when that Ghostty window closes.
command = /bin/zsh -l -c 'if tmux has-session -t main 2>/dev/null; then exec tmux new-session -t main \; set-option destroy-unattached on \; new-window; else exec tmux new-session -A -s main; fi'

# Window
macos-option-as-alt = true
window-width = 200
window-height = 50
window-padding-x = 8
#window-padding-y = 4
macos-titlebar-style = hidden
confirm-close-surface = false

# Colors
bold-color = bright
# Light/dark is switched with the `theme` shell function (~/.config/zsh/theme.zsh), which
# writes theme.ghostty (not in dotfiles). tmux, nvim and Claude Code follow Ghostty's theme.
# Fallback when theme.ghostty doesn't exist yet:
theme = GitHub Dark Default
config-file = ?theme.ghostty

# Keybindings
keybind = shift+enter=text:\x1b\r
