# Font
font-family = "BlexMono Nerd Font"
font-style = Light
font-thicken = true
font-style-bold = Light
font-style-italic = "Light Italic"
font-size = 13.5
adjust-cell-height = 4

# Shell
command = /bin/zsh -l -c 'tmux new-session -A -s main \; new-window'

# Window
macos-option-as-alt = true
window-width = 200
window-height = 50
window-padding-x = 8
#window-padding-y = 4
macos-titlebar-style = hidden
confirm-close-surface = false

# Colors
bold-color = bright
# Light/dark is switched with the `theme` shell function (~/.config/zsh/theme.zsh), which
# writes theme.ghostty (not in dotfiles). tmux, nvim and Claude Code follow Ghostty's theme.
# Fallback when theme.ghostty doesn't exist yet:
theme = GitHub Dark Default
config-file = ?theme.ghostty

# Keybindings
keybind = shift+enter=text:\x1b\r
